# Copia este archivo como ".env" (en la carpeta backend) y ajusta tus datos.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

PORT=3000
CORS_ORIGIN=http://localhost:5173

# En la nube usa solo esta línea (Neon, Supabase, Render...) y deja las DB_* sin usar:
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_NAME=saiyagym
DB_USER=postgres
DB_PASSWORD=escribe_aqui_tu_clave_de_postgres

# Clave con la que se firman las sesiones (inicio de sesión).
# Escribe una frase larga y propia (mínimo 16 caracteres). No la compartas.
JWT_SECRET=cambia_esta_frase_por_una_larga_y_secreta
# Duración de la sesión (ejemplos: 8h, 1d)
JWT_EXPIRA=8h

# Zona horaria del gimnasio: define qué día es "hoy" para pagos, rutinas y membresías.
# (Si no la escribes, se usa America/Bogota.)
ZONA_HORARIA=America/Bogota
